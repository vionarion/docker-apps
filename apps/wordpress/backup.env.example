# offen/docker-volume-backup: nightly archive of the volumes, uploaded over WebDAV.
# Copy to backup.env and fill in. Docs: https://offen.github.io/docker-volume-backup/
BACKUP_CRON_EXPRESSION="0 3 * * *"
BACKUP_COMPRESSION="gz"
BACKUP_FILENAME="backup-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_RETENTION_DAYS="7"
BACKUP_PRUNING_PREFIX="backup-"
WEBDAV_URL="https://webdav.example.com"
WEBDAV_PATH="backups/wordpress"
WEBDAV_USERNAME="user"
WEBDAV_PASSWORD=""
