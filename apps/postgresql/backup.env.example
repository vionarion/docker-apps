# offen/docker-volume-backup: nightly archive of the volume, uploaded over WebDAV.
# Copy to backup.env and fill in. Docs: https://offen.github.io/docker-volume-backup/
BACKUP_CRON_EXPRESSION="0 3 * * *"
BACKUP_COMPRESSION="gz"
BACKUP_FILENAME="backup-%Y-%m-%dT%H-%M-%S.{{ .Extension }}"
BACKUP_RETENTION_DAYS="7"
BACKUP_PRUNING_PREFIX="backup-"
WEBDAV_URL="https://webdav.example.com"
WEBDAV_PATH="backups/postgresql"
WEBDAV_USERNAME="user"
WEBDAV_PASSWORD=""
# Stop only this app's container (label value in docker-compose.yml) during backup for a consistent snapshot
BACKUP_STOP_DURING_BACKUP_LABEL="postgres"
