APP_DOMAIN=pdf.example.com
# Image edition:
#   EDITION=             full: everything incl. OCR and Word/Excel <-> PDF (~1.5 GB RAM)
#   EDITION=-ultra-lite  crop, merge, split, rotate, compress, redact; no OCR/LibreOffice (~300 MB RAM)
#   EDITION=-fat         full + extra fonts, works offline
EDITION=
MEMORY_LIMIT=1536m
# for -ultra-lite set MEMORY_LIMIT=512m
# first admin, change the password after the first login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
LOCALE=ru-RU
# Tesseract OCR languages
OCR_LANGS=rus,eng
